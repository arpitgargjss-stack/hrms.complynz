# Copy to .env (never commit). Values are placeholders.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5999/hrms
PORT=5100
HR_APP_URL=https://hrms.complynz.com
STAFF_EMAIL_DOMAIN=complynz.com
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
FILE_STORAGE_DIR=./storage
# 32+ random chars; keep constant once data exists
FIELD_ENCRYPTION_KEY=
HMAC_PEPPER=
# Email (OTP codes, offer and onboarding links, reminders) is sent through Resend.
# Required in production: without it no email is sent and OTP requests return an error.
# Create the key at resend.com > API Keys (starts with re_).
RESEND_API_KEY=
# Sender address. Its domain must show "Verified" in Resend > Domains (add Resend's SPF and DKIM
# DNS records for complynz.com), or Resend rejects every send. "Name <addr>" form also works.
EMAIL_FROM=hr@complynz.com
