{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "jsx": "react-jsx", "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node"],
    "baseUrl": ".", "paths": { "@shared/*": ["shared/*"], "@/*": ["client/src/*"] },
    "allowImportingTsExtensions": true
  },
  "include": ["shared", "server", "client/src", "drizzle.config.ts", "vite.config.ts"]
}
